# Core backend
APP_ENV=development
HTTP_ADDR=:8080
GRPC_ADDR=:9090
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cpay?sslmode=disable
MIGRATIONS_PATH=./migrations
JWT_SECRET=cpay-dev-jwt-secret
KEY_ENCRYPTION_KEY=cpay-dev-master-key-change-me
DEFAULT_TOLERANCE_PERCENT=0.25
AUTH_GRPC_ADDR=localhost:9091
PAYMENT_LINK_GRPC_ADDR=localhost:9092
CHECKOUT_GRPC_ADDR=localhost:9093

# Database
DB_PASSWORD=changeme

# Auth
JWT_SECRET=your-jwt-secret-here

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# RPC
RPC_URL_POLYGON=https://polygon-rpc.com
# Optional overrides for built-in Chainlist-sourced defaults.
# CHAIN_RPC_URLS=ethereum=https://ethereum-rpc.publicnode.com,base=https://base-rpc.publicnode.com,hyperevm=https://rpc.hypurrscan.io
# CHAIN_RPC_FALLBACK_URLS=hyperevm=https://hyperliquid.drpc.org|https://rpc.hyperliquid.xyz/evm

# MinIO
MINIO_ROOT_USER=cpay-admin
MINIO_ROOT_PASSWORD=cpay-secret-key
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=cpay-invoices
MINIO_USE_SSL=false

# Bootstrap admin
BOOTSTRAP_MERCHANT_NAME=Demo Merchant
BOOTSTRAP_ADMIN_EMAIL=admin@cpay.dev
BOOTSTRAP_ADMIN_PASSWORD=admin123

# NATS
NATS_URL=nats://localhost:4222

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=

# CREATE2 checkout wallets and payouts
# Deploy contracts/CheckoutWalletFactory.sol on each EVM chain with the payout hot wallet as initialSweeper.
# CHECKOUT_WALLET_FACTORY_ADDRESSES must point to that deployed project factory, not a generic CREATE2 deployer.
# CHECKOUT_WALLET_FACTORY_ADDRESSES=hyperevm=0x0000000000000000000000000000000000000000
# PAYOUT_HOT_WALLET_PRIVATE_KEY=0x...
# PAYOUT_GAS_BUFFER_PERCENT=20
